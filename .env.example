# App
APP_ENV=development
LOG_LEVEL=INFO

# Database (local/dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yelp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Service URLs (host machine)
BUSINESS_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost,http://frontend:3000

# Auth (dev defaults only)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=yelp-auth
JWT_AUDIENCE=yelp-api
JWT_LEEWAY_SECONDS=5
JWT_ROLES_CLAIM=roles
BUSINESS_REQUIRED_ROLES=business:read
RECOMMENDATION_REQUIRED_ROLES=recommendation:read
USER_STATUS_PATH_TEMPLATE=/users/{user_id}/status
USER_STATUS_TIMEOUT_SECONDS=3

# Service internals for Docker network
BUSINESS_SERVICE_GRPC=business-service:50051
DATA_PATH=/data/raw

# Search rollout
SEARCH_PATH_DEFAULT=auto
ENABLE_FTS=true
ENABLE_TRIGRAM_FALLBACK=true

# Frontend
API_URL=http://localhost:8000
NEXT_PUBLIC_SHOW_SEARCH_DEBUG=1
NEXT_PUBLIC_API_AUTH_TOKEN=

# SQLAlchemy URLs used by Python services
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/yelp
BUSINESS_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp
RECOMMENDATION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp
INGESTION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp

# Redis (Sprint 1 cache foundation)
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=0.2
