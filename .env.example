# App
APP_ENV=development
LOG_LEVEL=INFO

# Database (local/dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yelp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Service URLs (host machine)
BUSINESS_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost,http://frontend:3000

# Auth (dev defaults only)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=yelp-auth
JWT_AUDIENCE=yelp-api
JWT_LEEWAY_SECONDS=5
JWT_ROLES_CLAIM=roles
BUSINESS_REQUIRED_ROLES=business:read
RECOMMENDATION_REQUIRED_ROLES=recommendation:read
USER_STATUS_PATH_TEMPLATE=/users/{user_id}/status
USER_STATUS_TIMEOUT_SECONDS=3
# Dev-only: allow synthetic load-test JWT claim (dev_load_test=true) to skip user-status lookup.
# Keep FALSE by default to avoid accidental auth bypass during normal development.
ENABLE_DEV_LOAD_TEST_BYPASS=false

# Service internals for Docker network
BUSINESS_SERVICE_GRPC=business-service:50051
DATA_PATH=/data/raw

# Search rollout
SEARCH_PATH_DEFAULT=auto
ENABLE_FTS=true
ENABLE_TRIGRAM_FALLBACK=true

# Frontend
API_URL=http://localhost:8000
NEXT_PUBLIC_SHOW_SEARCH_DEBUG=1
NEXT_PUBLIC_API_AUTH_TOKEN=

# SQLAlchemy URLs used by Python services
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/yelp
BUSINESS_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp
RECOMMENDATION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp
INGESTION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp

# Redis
REDIS_ENABLED=true
REDIS_TIMEOUT_SECONDS=0.2

# Redis auth — must match REDIS_PASSWORD below; override in production
# In docker-compose REDIS_URL is always derived from REDIS_PASSWORD, so set this one field.
REDIS_PASSWORD=dev_redis_pass
# When connecting from host machine directly (e.g. redis-cli):
# redis-cli -h localhost -p 6379 -a dev_redis_pass
# In production: set a strong REDIS_PASSWORD; update REDIS_URL to:
# REDIS_URL=redis://:your-strong-password@redis:6379/0
REDIS_URL=redis://:dev_redis_pass@redis:6379/0

# Cache rollout control
# CACHE_ROLLOUT_PERCENT: 0=off, 1-99=partial canary, 100=full (default)
# CACHE_SHADOW_MODE: true=always serve from DB, log cache match/mismatch (never serve stale)
CACHE_ROLLOUT_PERCENT=100
CACHE_SHADOW_MODE=false
