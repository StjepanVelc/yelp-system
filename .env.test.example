# Test environment profile
APP_ENV=test
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yelp_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/yelp_test
BUSINESS_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp_test
RECOMMENDATION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp_test
INGESTION_DATABASE_URL=postgresql://postgres:change_me@db:5432/yelp_test

# Service URLs
BUSINESS_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8003
API_GATEWAY_URL=http://localhost:8000
USER_SERVICE_URL=http://localhost:8001
BUSINESS_SERVICE_GRPC=localhost:50051

# Auth
JWT_SECRET=test-secret-change-me
JWT_ALGORITHM=HS256
JWT_ISSUER=yelp-auth
JWT_AUDIENCE=yelp-api
JWT_LEEWAY_SECONDS=5
JWT_ROLES_CLAIM=roles
BUSINESS_REQUIRED_ROLES=business:read
RECOMMENDATION_REQUIRED_ROLES=recommendation:read
USER_STATUS_PATH_TEMPLATE=/users/{user_id}/status
USER_STATUS_TIMEOUT_SECONDS=3

# Frontend
API_URL=http://localhost:8000
NEXT_PUBLIC_SHOW_SEARCH_DEBUG=1
